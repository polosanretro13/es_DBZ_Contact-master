    <image name="md_marquee">
		<rotation>0</rotation>
		<color>ffffff</color>
		<colorEnd>ffffff</colorEnd>
		<gradientType>horizontal</gradientType>
		<linearSmooth>true</linearSmooth>
		<reflexion>0</reflexion>	  		
