	<!-- on masque les cartridges si on est dans une collection -->
	<image name="cartridge_ID" if="{system.sortedBy} == 'Collections' || 
								   {system.theme} == 'mess' || 
								   {system.theme} == 'ports'">
		<visible>false</visible>
    </image>


