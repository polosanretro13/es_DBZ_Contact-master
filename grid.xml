		<maxSize>0.49 0.17</maxSize>
		<pos>0.26 0.10</pos>
		<visible>true</visible>
		<zIndex>2001</zIndex>
		
	</image>


     <image name="thumbnail_ID" extra="true">
		<path>{game:thumbnail}</path>
		<origin>0.5 0.5</origin>									
		<pos>0.86 0.73</pos>									
		<maxSize>0.1266667 0.4314815</maxSize>								
		<linearSmooth>true</linearSmooth>
		<zIndex>2002</zIndex> 
		<verticalAlignment>bottom</verticalAlignment>
		<scale>1</scale>
	</image>


     <image name="boxback_ID" extra="true">
		<path>{game:boxback}</path>
		<origin>0.5 0.5</origin>									
		<pos>0.86 0.752</pos>									
		<maxSize>0.1266667 0.4314815</maxSize>
		<linearSmooth>true</linearSmooth>
		<opacity>0</opacity>
		<zIndex>2003</zIndex>

		<storyboard event="activate">   
			<animation property="opacity" to="1" begin="6500" duration="1" mode="linear"/>
			<animation property="x" from="1.1" to="0.7999" begin="6500" duration="1000" mode="EaseInOut"/>
			<animation property="offsetX" to="1.1" begin="12500" duration="700" mode="linear"/>
			<animation  property="opacity" to="0" begin="12500" duration="100" mode="linear"/>
		</storyboard>
	</image>
	
	
	<image name="cartridge_ID" extra="true">
		<path>{game:cartridge}</path>
		<origin>1 0.5</origin>									
		<pos>0.82 0.833</pos>								
		<maxSize>0.2 0.2</maxSize>
		<opacity>0</opacity>
		<zIndex>2003</zIndex>
		<scale>1</scale>
		<storyboard event="activate">   
			<animation property="opacity" to="1" begin="1000" duration="1" mode="linear"/>
			<animation property="x" from="1.1" to="0.7999" begin="1000" duration="1000" mode="EaseInOut"/>
			<animation property="offsetX" to="1.1" begin="6000" duration="700" mode="linear"/>
			<animation property="opacity" to="0" begin="6600" duration="100" mode="linear"/>
			<animation property="x" from="1.1" to="0.7999" begin="12500" duration="1000" mode="EaseInOut"/>
			<animation property="opacity" to="1" begin="12500" duration="1" mode="linear"/>
			<animation property="offsetX" to="0.002"  begin="12500" duration="1000" mode="bump"/>
		</storyboard>



    </image>
	
	<!-- Système avec un CD taille normale qui tourne -->
	<image name="cartridge_ID" if="{system.theme} == '3do' || 
								   {system.theme} == 'amigacd32' || 
								   {system.theme} == 'amigacdtv' || 
								   {system.theme} == 'atarijaguarcd' || 
								   {system.theme} == 'cdi' ||
								   {system.theme} == 'daphne' ||	
								   {system.theme} == 'dreamcast' ||
								   {system.theme} == 'gc' || 
								   {system.theme} == 'naomi' || 
								   {system.theme} == 'naomi2' ||
								   {system.theme} == 'neogeocd' || 
								   {system.theme} == 'pce-cd' || 
								   {system.theme} == 'ps2' || 
								   {system.theme} == 'ps2G' || 
								   {system.theme} == 'ps3' || 
								   {system.theme} == 'ps3G' || 
								   {system.theme} == 'ps4' || 
								   {system.theme} == 'psx' || 
								   {system.theme} == 'saturn' || 
								   {system.theme} == 'segacd' || 
								   {system.theme} == 'switch' ||
								   {system.theme} == 'triforce' || 
								   {system.theme} == 'triforce2' || 
								   {system.theme} == 'wii' || 
								   {system.theme} == 'wiiu' || 
								   {system.theme} == 'windows' || 
								   {system.theme} == 'windows2' || 
								   {system.theme} == 'xbox' || 
								   {system.theme} == 'xbox360' " extra="true">
		<horizontalAlignment>center</horizontalAlignment>
		<pos>0.7999 0.787 </pos>								
		<maxSize>0.2 0.2</maxSize>	
		<zIndex>2001</zIndex>
		<storyboard event="activate">   
			<animation property="opacity" to="1" begin="1000" duration="1" mode="linear"/>
			<animation property="x" from="1.1" to="0.7999" begin="1000" duration="1000" mode="EaseInOut"/>
			<animation property="rotation" to="360" begin="2000" duration="5000" mode="linear"/>
			<animation property="offsetX" to="1.1" begin="6000" duration="700" mode="linear"/>
			<animation property="opacity" to="0" begin="6600" duration="100" mode="linear"/>
			<animation property="opacity" to="1" begin="12500" duration="1" mode="linear"/>
			<animation property="x" from="1.1" to="0.7999" begin="12500" duration="1000" mode="EaseInOut"/>
			<animation property="offsetX" to="0.002"  begin="12500" duration="1000" mode="bump"/>
			<animation property="rotation" to="720"  begin="13300" duration="7000" mode="EaseInOut"/>
		</storyboard>
    </image>


	
	<!-- n64-->
	<image name="boxback_ID" if="{system.theme} == 'n64' " extra="true">										
